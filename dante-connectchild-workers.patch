 static void
+connectworker_reap(sig)
+   int sig;
+{
+   const int errno_s = errno;
+
+   while (waitpid(-1, NULL, WNOHANG) > 0)
+      if (connectworkers > 0)
+         --connectworkers;
+
+   errno = errno_s;
+}
+
+static void
+connectworker_alarm(sig)
+   int sig;
+{
+   const int errno_s = errno;
+
+   if (connectworker_control != -1)
+      shutdown(connectworker_control, SHUT_RDWR);
+
+   errno = errno_s;
+}
