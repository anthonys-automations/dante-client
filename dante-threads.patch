+/*
+ * SIGIO goes to whichever thread of the program the kernel picks, so several
+ * instances of the handler can run at once, and the handler changes the
+ * address table (socks_addaddr(), dup2() onto the program's fd) that the
+ * program's other threads use too.  Run it with the address lock held: one
+ * instance at a time, and no other thread in the table meanwhile.  An
+ * instance that has to wait still drains the replies, so none is lost.
+ */
 static void
 sigio(sig, sip, scp)
    int sig;
    siginfo_t *sip;
    void *scp;
+{
+   const int errno_s = errno;
+   addrlockopaque_t lock;
+
+   socks_addrlock(F_WRLCK, &lock);
+   sigio_locked(sig, sip, scp);
+   socks_addrunlock(&lock);
+
+   errno = errno_s;
+}
+
+static void
+sigio_locked(sig, sip, scp)
+   int sig;
+   siginfo_t *sip;
+   void *scp;
 {
    const char *function = "sigio()";
    const int errno_s = errno;
