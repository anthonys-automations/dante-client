+#if SOCKS_CLIENT && defined(__linux__)
+#include <sys/epoll.h>
+
+/*
+ * Not socksified: interposed only so that socks_dup2() can keep the
+ * program's epoll registrations when we replace a socket behind one of its
+ * descriptors (non-blocking connect, IPv6 proxy server).
+ */
+int
+epoll_ctl(epfd, op, fd, event)
+   int epfd;
+   int op;
+   int fd;
+   struct epoll_event *event;
+{
+   static int (*sys)(int, int, int, struct epoll_event *);
+
+   if (sys == NULL
+   &&  (sys = (int (*)(int, int, int, struct epoll_event *))
+              dlsym(RTLD_NEXT, "epoll_ctl")) == NULL) {
+      errno = ENOSYS;
+      return -1;
+   }
+
+   if (doing_addrinit || sockscf.state.executingdnscode)
+      return sys(epfd, op, fd, event);
+
+   clientinit();
+
+   return socks_epoll_ctl(sys, epfd, op, fd, event);
+}
+#endif /* SOCKS_CLIENT && __linux__ */
+
 static libsymbol_t *
