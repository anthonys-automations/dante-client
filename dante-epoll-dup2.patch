+#if SOCKS_CLIENT && defined(__linux__)
+#include <sys/epoll.h>
+
+/*
+ * The program's epoll registrations: epoll keys them by descriptor *and*
+ * open file, so they disappear when we dup2() another socket onto the
+ * descriptor.  Kept with the identity of the file registered, so a stale
+ * entry (descriptor closed and reused) is never carried over.  Protected by
+ * the address lock, which sigio() holds too.
+ */
+typedef struct {
+   int                epfd;
+   int                fd;
+   dev_t              dev;
+   ino_t              ino;
+   struct epoll_event event;
+} epollreg_t;
+
+static epollreg_t *epollregv;
+static size_t     epollregc, epollregmax;
+static int        (*sys_epoll_ctl_fn)(int, int, int, struct epoll_event *);
+
+static int
+fdidentity(const int fd, dev_t *dev, ino_t *ino);
+
+static int
+fdidentity(fd, dev, ino)
+   const int fd;
+   dev_t *dev;
+   ino_t *ino;
+{
+   struct stat st;
+
+   if (fstat(fd, &st) != 0)
+      return -1;
+
+   *dev = st.st_dev;
+   *ino = st.st_ino;
+
+   return 0;
+}
+
+int
+socks_epoll_ctl(sys, epfd, op, fd, event)
+   int (*sys)(int, int, int, struct epoll_event *);
+   int epfd;
+   int op;
+   int fd;
+   struct epoll_event *event;
+{
+   addrlockopaque_t lock;
+   size_t i;
+   dev_t dev;
+   ino_t ino;
+   int rc, errno_s;
+
+   /* the call and the bookkeeping together, so socks_dup2() sees both. */
+   socks_addrlock(F_WRLCK, &lock);
+
+   sys_epoll_ctl_fn = sys;
+   rc               = sys(epfd, op, fd, event);
+   errno_s          = errno;
+
+   if (rc == 0) {
+      for (i = 0; i < epollregc; ++i)
+         if (epollregv[i].epfd == epfd && epollregv[i].fd == fd)
+            break;
+
+      if (op == EPOLL_CTL_DEL || event == NULL
+      ||  fdidentity(fd, &dev, &ino) != 0) {
+         if (i < epollregc)
+            epollregv[i] = epollregv[--epollregc];
+      }
+      else {
+         if (i == epollregc) {
+            if (epollregc == epollregmax) {
+               const size_t newmax = epollregmax == 0 ? 64 : epollregmax * 2;
+               epollreg_t *p;
+
+               if ((p = realloc(epollregv, newmax * sizeof(*p))) == NULL) {
+                  /* can not remember it; it just will not be carried over. */
+                  socks_addrunlock(&lock);
+                  errno = errno_s;
+                  return rc;
+               }
+
+               epollregv   = p;
+               epollregmax = newmax;
+            }
+
+            ++epollregc;
+         }
+
+         epollregv[i].epfd  = epfd;
+         epollregv[i].fd    = fd;
+         epollregv[i].dev   = dev;
+         epollregv[i].ino   = ino;
+         epollregv[i].event = *event;
+      }
+   }
+
+   socks_addrunlock(&lock);
+
+   errno = errno_s;
+   return rc;
+}
+#endif /* SOCKS_CLIENT && __linux__ */
+
+int
+socks_dup2(oldfd, newfd)
+   int oldfd;
+   int newfd;
+{
+#if SOCKS_CLIENT && defined(__linux__)
+   addrlockopaque_t lock;
+   size_t i;
+   dev_t dev;
+   ino_t ino;
+   int rc, errno_s, haveold;
+
+   socks_addrlock(F_WRLCK, &lock);
+
+   haveold = epollregc > 0 && fdidentity(newfd, &dev, &ino) == 0;
+
+   rc      = dup2(oldfd, newfd);
+   errno_s = errno;
+
+   if (rc != -1 && haveold) {
+      for (i = 0; i < epollregc; ) {
+         epollreg_t *r = &epollregv[i];
+
+         if (r->fd != newfd || r->dev != dev || r->ino != ino) {
+            ++i;
+            continue;
+         }
+
+         /* registered with the file we just replaced: register the new one. */
+         if (sys_epoll_ctl_fn(r->epfd, EPOLL_CTL_ADD, newfd, &r->event) == 0
+         ||  errno == EEXIST) {
+            (void)fdidentity(newfd, &r->dev, &r->ino);
+            ++i;
+         }
+         else  /* epoll fd gone, or the like. */
+            epollregv[i] = epollregv[--epollregc];
+      }
+   }
+
+   socks_addrunlock(&lock);
+
+   errno = errno_s;
+   return rc;
+
+#else /* !(SOCKS_CLIENT && __linux__) */
+
+   return dup2(oldfd, newfd);
+
+#endif /* !(SOCKS_CLIENT && __linux__) */
+}
