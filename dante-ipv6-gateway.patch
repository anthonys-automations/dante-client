+   const int family;
+{
+   struct addrinfo *first = NULL, **firstnext = &first,
+                   *rest  = NULL, **restnext  = &rest;
+
+   for (; ai != NULL; ai = ai->ai_next) {
+      if (ai->ai_family == family) {
+         *firstnext = ai;
+         firstnext  = &ai->ai_next;
+      }
+      else {
+         *restnext = ai;
+         restnext  = &ai->ai_next;
+      }
+   }
+
+   *restnext  = NULL;
+   *firstnext = rest;
+
+   return first;
