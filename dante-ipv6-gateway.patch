+#if SOCKS_CLIENT
+
+/* IP-level options with an equivalent in the other family. */
+static const struct {
+   int         level4, optname4, level6, optname6;
+   const char  *optstr;
+} ipoptmap[] = {
+   { IPPROTO_IP, IP_TOS, IPPROTO_IPV6, IPV6_TCLASS,       "IP_TOS"   },
+   { IPPROTO_IP, IP_TTL, IPPROTO_IPV6, IPV6_UNICAST_HOPS, "IP_TTL"   },
+};
+
+int
+socks_resocket(s, af)
+   int s;
+   sa_family_t af;
+{
+   const char *function = "socks_resocket()";
+   struct sockaddr_storage local, newlocal;
+   socketoptvalue_t val, defval;
+   socklen_t len, deflen;
+   unsigned int i;
+   int new_s, ref_s, type, flags, fdflags, errno_s;
+
+   if (af != AF_INET && af != AF_INET6) {
+      errno = EAFNOSUPPORT;
+      return -1;
+   }
+
+   len = sizeof(local);
+   if (getsockname(s, TOSA(&local), &len) == -1)
+      return -1;
+
+   if (local.ss_family == af)
+      return 0;
+
+   if (local.ss_family != AF_INET && local.ss_family != AF_INET6) {
+      errno = EAFNOSUPPORT;
+      return -1;
+   }
+
+   len = sizeof(type);
+   if (getsockopt(s, SOL_SOCKET, SO_TYPE, &type, &len) == -1)
+      return -1;
+
+   if ((flags   = fcntl(s, F_GETFL, 0)) == -1
+   ||  (fdflags = fcntl(s, F_GETFD, 0)) == -1)
+      return -1;
+
+   slog(LOG_DEBUG, "%s: replacing fd %d (local %s) with an %s socket",
+        function, s, sockaddr2string(&local, NULL, 0), AFNAME(af));
+
+   if ((new_s = socket(af, type, 0)) == -1)
+      return -1;
+
+   for (i = 0; i < HAVE_DUPSOCKOPT_MAX; ++i) {
+      if (option[i].level == IPPROTO_IP
+#ifdef IPPROTO_IPV6
+      ||  option[i].level == IPPROTO_IPV6
+#endif /* IPPROTO_IPV6 */
+      )
+         continue; /* family-specific, see ipoptmap. */
+
+      len = sizeof(val);
+      if (getsockopt(s, option[i].level, option[i].optname, &val, &len) == -1)
+         continue;
+
+      if (setsockopt(new_s, option[i].level, option[i].optname, &val, len)
+      == -1)
+         if (errno != ENOPROTOOPT)
+            slog(LOG_DEBUG, "%s: setsockopt(%s) failed: %s",
+                 function, option[i].optstr, strerror(errno));
+   }
+
+   /*
+    * Only carry over IP-level values the program changed, i.e., that differ
+    * from those of a new socket.  Otherwise we would replace "use the
+    * default" with a fixed value.
+    */
+   ref_s = socket(local.ss_family, type, 0);
+
+   for (i = 0; i < ELEMENTS(ipoptmap); ++i) {
+      const int fromlevel = local.ss_family == AF_INET ?
+                              ipoptmap[i].level4 : ipoptmap[i].level6;
+      const int fromopt   = local.ss_family == AF_INET ?
+                              ipoptmap[i].optname4 : ipoptmap[i].optname6;
+      const int tolevel   = af == AF_INET ?
+                              ipoptmap[i].level4 : ipoptmap[i].level6;
+      const int toopt     = af == AF_INET ?
+                              ipoptmap[i].optname4 : ipoptmap[i].optname6;
+
+      len = sizeof(val.int_val);
+      if (getsockopt(s, fromlevel, fromopt, &val.int_val, &len) == -1)
+         continue;
+
+      deflen = sizeof(defval.int_val);
+      if (ref_s != -1
+      &&  getsockopt(ref_s, fromlevel, fromopt, &defval.int_val, &deflen) == 0
+      &&  defval.int_val == val.int_val)
+         continue;
+
+      if (setsockopt(new_s, tolevel, toopt, &val.int_val, len) == -1)
+         slog(LOG_DEBUG, "%s: could not carry %s (%d) over to the %s socket: %s",
+              function,
+              ipoptmap[i].optstr,
+              val.int_val,
+              AFNAME(af),
+              strerror(errno));
+      else
+         slog(LOG_DEBUG, "%s: carried %s (%d) over to the %s socket",
+              function, ipoptmap[i].optstr, val.int_val, AFNAME(af));
+   }
+
+   if (ref_s != -1)
+      close(ref_s);
+
+   if (fcntl(new_s, F_SETFL, flags) == -1)
+      goto fail;
+
+   if (PORTISBOUND(&local) && !IPADDRISBOUND(&local)) {
+      /*
+       * Program bound a port on the wildcard address.  Keep the port.
+       * The old socket still holds it, so IPV6_V6ONLY is needed for the
+       * IPv6 socket not to collide with it.
+       */
+      bzero(&newlocal, sizeof(newlocal));
+      SET_SOCKADDR(&newlocal, af);
+      if (af == AF_INET)
+         TOIN(&newlocal)->sin_addr.s_addr = htonl(INADDR_ANY);
+      else {
+         const int one = 1;
+
+         TOIN6(&newlocal)->sin6_addr = in6addr_any;
+         if (setsockopt(new_s, IPPROTO_IPV6, IPV6_V6ONLY, &one, sizeof(one))
+         == -1)
+            slog(LOG_DEBUG, "%s: setsockopt(IPV6_V6ONLY) failed: %s",
+                 function, strerror(errno));
+      }
+
+      SET_SOCKADDRPORT(&newlocal, GET_SOCKADDRPORT(&local));
+
+      if (bind(new_s, TOSA(&newlocal), salen(newlocal.ss_family)) == -1) {
+         swarn("%s: could not bind %s for fd %d",
+               function, sockaddr2string(&newlocal, NULL, 0), s);
+         goto fail;
+      }
+   }
+   else if (IPADDRISBOUND(&local))
+      slog(LOG_DEBUG,
+           "%s: fd %d was bound to %s.  That address is not usable on an "
+           "%s socket, so the new socket is left unbound",
+           function,
+           s,
+           sockaddr2string(&local, NULL, 0),
+           AFNAME(af));
+
+   if (dup2(new_s, s) == -1)
+      goto fail;
+
+   close(new_s);
+
+   if (fcntl(s, F_SETFD, fdflags) == -1)
+      slog(LOG_DEBUG, "%s: fcntl(F_SETFD) on fd %d failed: %s",
+           function, s, strerror(errno));
+
+   return 0;
+
+fail:
+   errno_s = errno;
+   close(new_s);
+   errno = errno_s;
+
+   return -1;
+}
+
+#endif /* SOCKS_CLIENT */
