{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "description": "Updates the Alpine base image, Dante source release and GitHub Actions used by this repository.",
  "timezone": "Etc/UTC",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "separateMajorMinor": false,
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG DANTE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\r?\\nARG DANTE_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "dante",
      "datasourceTemplate": "custom.dante",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "ARG DANTE_VERSION={{{newValue}}}\nARG DANTE_SHA256={{{newDigest}}}"
    }
  ],
  "customDatasources": {
    "dante": {
      "defaultRegistryUrlTemplate": "https://www.inet.no/dante/download.html",
      "format": "plain",
      "transformTemplates": [
        "($items := $split($join(releases.version, ' '), '<li>'); {\"releases\": [$map($items, function($item) { ($version := $match($item, /Dante ([0-9]+\\.[0-9]+\\.[0-9]+)/); $digest := $match($item, /SHA256: ([a-f0-9]{64})/); $exists($version) and $exists($digest) ? {\"version\": $version.groups[0], \"digest\": $digest.groups[0]} : undefined) })], \"homepage\": \"https://www.inet.no/dante/\"})"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Group Dockerfile dependency updates for image compatibility validation.",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "all dependencies",
      "automerge": true
    },
    {
      "description": "GitHub Actions updates are listed on the dependency dashboard for manual application because GITHUB_TOKEN cannot push changes under .github/workflows.",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
